<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms stays referenced only for the handful of APIs WPF has no equivalent for:
         Screen (monitor enumeration for pen targeting) and NotifyIcon (tray icon). Its and WPF's
         implicit usings both define types like Button/MessageBox/Application, so both sets are
         removed below and the few call sites that need a WinForms type name it explicitly. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- POINTER_TYPE_INFO's FieldOffset(8) (see Input/NativeMethods.cs) is only correct with
         8-byte pointer alignment. Restricting to x64 keeps that assumption true; Program.cs
         also asserts Environment.Is64BitProcess at startup as a defense-in-depth check. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Per-monitor DPI awareness so Screen.AllScreens bounds (used for pointer injection
         coordinates) reflect true physical pixels on mixed-DPI multi-monitor setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF's text layout needs real culture data (XmlLanguage.GetSpecificCulture) — with
         InvariantGlobalization on, every window crashes immediately on first render. -->
    <Version>2.0.0</Version>
    <Product>PenBridge</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="tools\LICENSE*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="tools\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Lets the WinForms (non-Web SDK) project host Kestrel/ASP.NET Core WebApplication directly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PenBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adding UseWPF drops the SDK's usual base implicit usings (System.IO, System.Net.Http) as a
         side effect, so they're restored explicitly here. System.Drawing/System.Windows.Forms are
         intentionally NOT restored globally: WPF defines several same-named types (Application,
         Button, MessageBox, ...), so the few call sites still needing a WinForms type name it
         explicitly instead of importing the whole namespace project-wide. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
