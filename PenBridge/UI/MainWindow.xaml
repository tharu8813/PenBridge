<Window x:Class="PenBridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenBridge" Width="640" Height="680" MinWidth="580" MinHeight="520"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="10"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.32"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.32">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Height="68">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2F6FED" Offset="0"/>
                    <GradientStop Color="#16327D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="22,0" VerticalAlignment="Center">
                <Image x:Name="HeaderIcon" Width="34" Height="34" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <TextBlock Text="PenBridge" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#C7D6FB" VerticalAlignment="Center" Margin="10,3,0,0" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- Setup + connect cards -->
        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="설정" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="네트워크" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="NetworkCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource AppComboBox}"
                                  Margin="0,0,0,10" HorizontalAlignment="Left" Width="320">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="포트" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource AppTextBox}"
                                 HorizontalAlignment="Left" Width="100"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="대상 모니터·입력·화면 설정은 iPad에서 변경하세요."/>
                    <Button x:Name="StartStopButton" Content="서버 시작" Style="{StaticResource AppButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Width="120"/>
                    <TextBlock Style="{StaticResource Hint}" Text="창을 닫으면 트레이로 숨겨집니다. 완전 종료는 트레이 메뉴를 이용하세요."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="iPad 연결" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border x:Name="StatusDotHost" Width="10" Height="10" CornerRadius="5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        </Border>
                        <TextBlock x:Name="StatusText" Text="중지됨" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="StatusDetailText" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="QrCard" Grid.Column="0" Width="152" Height="152" CornerRadius="12"
                                Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                VerticalAlignment="Top" Opacity="0">
                            <Image x:Name="QrImage" Margin="10" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="UrlBox" Style="{StaticResource AppTextBox}" Width="240" IsReadOnly="True"/>
                                <Button x:Name="CopyButton" Content="복사" Style="{StaticResource AppButton}" Tag="secondary"
                                        Width="64" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="공용 PenBridge 사이트에서 이 주소를 입력하거나 QR을 스캔하세요." Width="300"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,16,20,20">
            <DockPanel>
                <TextBlock Text="진단 / 로그" Style="{StaticResource CardTitle}" DockPanel.Dock="Top"/>
                <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" AcceptsReturn="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
