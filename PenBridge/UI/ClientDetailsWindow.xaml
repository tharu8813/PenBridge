<Window x:Class="PenBridge.UI.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenBridge · 연결 상세 정보" Width="560" Height="460" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/></Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Border Style="{StaticResource Card}" Margin="16">
            <DockPanel>
                <TextBlock Text="연결 상세 정보" Style="{StaticResource CardTitle}" DockPanel.Dock="Top"/>
                <TextBox x:Name="DetailsText" Style="{StaticResource LogBox}" IsReadOnly="True" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
